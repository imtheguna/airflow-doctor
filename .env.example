# Your Airflow (2.x, REST API v1, basic auth). Use host.docker.internal for Airflow on your Mac.
AIRFLOW_URL=http://localhost:8080
AIRFLOW_USER=airflow
AIRFLOW_PASSWORD=airflow

# Optional read-only warehouse access (schema / row-count tools). Empty = disabled.
WAREHOUSE_DSN=

# HTTP transport only: require "Authorization: Bearer <token>". Strongly recommended if not on localhost.
MCP_AUTH_TOKEN=

# --- Option 3: AI agent (docker compose --profile agent up -d). Uses the Google Gemini API (key: aistudio.google.com/apikey).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview,gemini-flash-latest,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
AGENT_AUTH_TOKEN=
